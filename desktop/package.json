{
  "name": "luna-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:review": "tauri build --no-bundle",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:build-flavors": "node scripts/verify-build-flavors.mjs",
    "supabase:reset": "supabase db reset --workdir .. --no-seed",
    "supabase:lint": "supabase db lint --local --level error --workdir ..",
    "supabase:start": "supabase start --workdir ..",
    "supabase:stop": "supabase stop --workdir ..",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:account-contract": "node --import tsx --test account-contract/supabaseAccountService.test.ts",
    "test:e2e": "pnpm build:e2e && wdio run wdio.conf.ts --spec e2e/account.spec.ts && wdio run wdio.conf.ts --spec e2e/conversation.spec.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/tauri-plugin": "^1.0.0",
    "@wdio/tauri-service": "^1.0.0",
    "@wdio/types": "^9.0.0",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.9",
    "supabase": "^2.109.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
